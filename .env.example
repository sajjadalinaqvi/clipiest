# Clipiest Environment Configuration
CLIPIEST_HOST=127.0.0.1
CLIPIEST_PORT=8780
CLIPIEST_DATA=

# AI Provider Configuration (gemini, openai, claude, groq, grok, openrouter, ollama)
CLIPIEST_AI_PROVIDER=gemini
CLIPIEST_AI_KEY=
CLIPIEST_AI_MODELS=gemini-2.5-flash,gpt-4o-mini
CLIPIEST_AI_BASE_URL=

# Speech Recognition (faster_whisper)
CLIPIEST_ASR_ENGINE=faster_whisper
CLIPIEST_WHISPER_MODEL=large-v3-turbo
CLIPIEST_CPU=0
